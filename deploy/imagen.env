# Lo que fija la imagen desplegable del SGC (#54). Cambiar algo aquí es cambiar la imagen:
# va por PR como cualquier cambio de código, y la versión de Frappe va aparte, en frappe.version.
#
# frappe_docker: su Containerfile «custom» construye Python, Node, wkhtmltopdf, nginx y el bench.
# Se fija a un commit y no a una rama: la rama main de frappe_docker cambia sola.
FRAPPE_DOCKER_REF=2b26e9ab8d751e5ea33bb7b930aea3550bb81ded
# Debian bookworm, no trixie (el defecto actual de frappe_docker): Dockerfile.overlay instala el
# cliente PostgreSQL 16 desde PGDG para bookworm y lo comprueba.
DEBIAN_BASE=bookworm
PYTHON_VERSION=3.14.7
NODE_VERSION=24
SGC_REPO=https://github.com/SciBack/sgc
