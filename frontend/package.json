{
  "name": "sgc-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:login-dom": "node --test tests/sgc_web.test.mjs",
    "verify:login-design:canary": "node scripts/verificar-capa-institucional-canary.mjs",
    "verify:login-design": "node scripts/verificar-capa-institucional.mjs ../sgc/public/css/themes/upeu.css && npm run verify:login-design:canary && node scripts/verificar-tokens-login.mjs && node scripts/verificar-contraste-login.mjs",
    "verify:design": "node scripts/design-system/verificar-stack.mjs src && node scripts/design-system/verificar-iconos.mjs src --sin-legado"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "frappe-ui": "1.0.0-beta.21",
    "pinia": "^2.1.7",
    "reicon-vue": "^1.1.102",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.2.8",
    "vitest": "^2.1.9"
  }
}
