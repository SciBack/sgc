<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Autoevaluacion" name="Autoevaluacion SGC" processRef="Process_Autoevaluacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Autoevaluacion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Planificada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_curso</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_En_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consolidada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_En_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Planificada" name="Planificada">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada__Iniciar_evaluacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_curso" name="En curso">
      <bpmn:incoming>Flow_Planificada__Iniciar_evaluacion</bpmn:incoming>
      <bpmn:incoming>Flow_En_revision__Devolver_a_evaluacion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_curso__Enviar_a_revision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_revision" name="En revision">
      <bpmn:incoming>Flow_En_curso__Enviar_a_revision</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_En_revision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Consolidada" name="Consolidada">
      <bpmn:incoming>Flow_En_revision__Consolidar</bpmn:incoming>
      <bpmn:outgoing>Flow_Consolidada__Cerrar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrada" name="Cerrada">
      <bpmn:incoming>Flow_Consolidada__Cerrar</bpmn:incoming>
      <bpmn:outgoing>Flow_fin_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_En_revision">
      <bpmn:incoming>Flow_gw_En_revision</bpmn:incoming>
      <bpmn:outgoing>Flow_En_revision__Devolver_a_evaluacion</bpmn:outgoing>
      <bpmn:outgoing>Flow_En_revision__Consolidar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrada" name="Fin">
      <bpmn:incoming>Flow_fin_Cerrada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificada__Iniciar_evaluacion" sourceRef="Task_Planificada" targetRef="Task_En_curso" name="Iniciar evaluacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_curso__Enviar_a_revision" sourceRef="Task_En_curso" targetRef="Task_En_revision" name="Enviar a revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_revision" sourceRef="Task_En_revision" targetRef="Gateway_En_revision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision__Devolver_a_evaluacion" sourceRef="Gateway_En_revision" targetRef="Task_En_curso" name="Devolver a evaluacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision__Consolidar" sourceRef="Gateway_En_revision" targetRef="Task_Consolidada" name="Consolidar">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consolidada__Cerrar" sourceRef="Task_Consolidada" targetRef="Task_Cerrada" name="Cerrar">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fin_Cerrada" sourceRef="Task_Cerrada" targetRef="End_Cerrada">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Autoevaluacion" bpmnElement="Participant_Autoevaluacion" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1346" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificada" bpmnElement="Task_Planificada">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_curso" bpmnElement="Task_En_curso">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_revision" bpmnElement="Task_En_revision">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Consolidada" bpmnElement="Task_Consolidada">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrada" bpmnElement="Task_Cerrada">
        <dc:Bounds x="1230" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_En_revision" bpmnElement="Gateway_En_revision">
        <dc:Bounds x="930" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrada" bpmnElement="End_Cerrada">
        <dc:Bounds x="1430" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificada__Iniciar_evaluacion" bpmnElement="Flow_Planificada__Iniciar_evaluacion">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_curso__Enviar_a_revision" bpmnElement="Flow_En_curso__Enviar_a_revision">
        <di:waypoint x="750" y="160" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_revision" bpmnElement="Flow_gw_En_revision">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="930" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_revision__Devolver_a_evaluacion" bpmnElement="Flow_En_revision__Devolver_a_evaluacion">
        <di:waypoint x="930" y="320" />
        <di:waypoint x="750" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_revision__Consolidar" bpmnElement="Flow_En_revision__Consolidar">
        <di:waypoint x="980" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Consolidada__Cerrar" bpmnElement="Flow_Consolidada__Cerrar">
        <di:waypoint x="1150" y="320" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_fin_Cerrada" bpmnElement="Flow_fin_Cerrada">
        <di:waypoint x="1350" y="320" />
        <di:waypoint x="1430" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
