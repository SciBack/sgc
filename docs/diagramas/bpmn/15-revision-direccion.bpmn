<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Revision_Direccion" name="Revision Direccion SGC" processRef="Process_Revision_Direccion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Revision_Direccion" isExecutable="false">
    <bpmn:documentation>La revisión por la dirección cierra el ciclo. ISO 9001:2015 §9.3 —recogida también en ISO 21001 §9.3— la asigna a la alta dirección «a intervalos planificados», enumera en §9.3.2 las entradas que debe considerar y en §9.3.3 las salidas que debe producir: decisiones sobre oportunidades de mejora, sobre los cambios necesarios en el sistema y sobre los recursos. Que el cierre lo ejecute la alta dirección y no la unidad de calidad no es un formalismo: es la alta dirección quien responde de la eficacia del sistema de gestión (§5.1.1), y esa responsabilidad no se delega en el área que lo administra.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Planificada__Realizar_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Realizada__Devolver_a_planificada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrada__Reabrir_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Realizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Rectorado_VR__lectura_" name="Rectorado/VR (lectura)">
        <bpmn:flowNodeRef>Task_Realizada__Cerrar_revision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Planificada__Realizar_revision" name="Realizar revision">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_Realizada_Devolver_a_planificada_hacia_Planificada</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada_Realizar_revision_hacia_Realizada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Realizada__Devolver_a_planificada" name="Devolver a planificada">
      <bpmn:incoming>Flow_gw_Realizada_Devolver_a_planificada</bpmn:incoming>
      <bpmn:outgoing>Flow_Realizada_Devolver_a_planificada_hacia_Planificada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Realizada__Cerrar_revision" name="Cerrar revision">
      <bpmn:incoming>Flow_gw_Realizada_Cerrar_revision</bpmn:incoming>
      <bpmn:outgoing>Flow_Realizada_Cerrar_revision_hacia_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrada__Reabrir_revision" name="Reabrir revision">
      <bpmn:incoming>Flow_Realizada_Cerrar_revision_hacia_Cerrada</bpmn:incoming>
      <bpmn:outgoing>Flow_Cerrada_Reabrir_revision_hacia_Realizada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Realizada" name="Realizada">
      <bpmn:incoming>Flow_Planificada_Realizar_revision_hacia_Realizada</bpmn:incoming>
      <bpmn:incoming>Flow_Cerrada_Reabrir_revision_hacia_Realizada</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Realizada_Devolver_a_planificada</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Realizada_Cerrar_revision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificada__Realizar_revision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificada_Realizar_revision_hacia_Realizada" sourceRef="Task_Planificada__Realizar_revision" targetRef="Gateway_Realizada">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Realizada_Devolver_a_planificada" sourceRef="Gateway_Realizada" targetRef="Task_Realizada__Devolver_a_planificada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Realizada_Devolver_a_planificada_hacia_Planificada" sourceRef="Task_Realizada__Devolver_a_planificada" targetRef="Task_Planificada__Realizar_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Realizada_Cerrar_revision" sourceRef="Gateway_Realizada" targetRef="Task_Realizada__Cerrar_revision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Realizada_Cerrar_revision_hacia_Cerrada" sourceRef="Task_Realizada__Cerrar_revision" targetRef="Task_Cerrada__Reabrir_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="Rectorado/VR (lectura)" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cerrada_Reabrir_revision_hacia_Realizada" sourceRef="Task_Cerrada__Reabrir_revision" targetRef="Gateway_Realizada">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Revision_Direccion" bpmnElement="Participant_Revision_Direccion" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1030" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1000" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Rectorado_VR__lectura_" bpmnElement="Lane_Rectorado_VR__lectura_" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1000" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificada__Realizar_revision" bpmnElement="Task_Planificada__Realizar_revision">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Realizada__Devolver_a_planificada" bpmnElement="Task_Realizada__Devolver_a_planificada">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Realizada__Cerrar_revision" bpmnElement="Task_Realizada__Cerrar_revision">
        <dc:Bounds x="830" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrada__Reabrir_revision" bpmnElement="Task_Cerrada__Reabrir_revision">
        <dc:Bounds x="1030" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Realizada" bpmnElement="Gateway_Realizada">
        <dc:Bounds x="630" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="312" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="348" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificada_Realizar_revision_hacia_Realizada" bpmnElement="Flow_Planificada_Realizar_revision_hacia_Realizada">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Realizada_Devolver_a_planificada" bpmnElement="Flow_gw_Realizada_Devolver_a_planificada">
        <di:waypoint x="680" y="160" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Realizada_Devolver_a_planificada_hacia_Planificada" bpmnElement="Flow_Realizada_Devolver_a_planificada_hacia_Planificada">
        <di:waypoint x="830" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Realizada_Cerrar_revision" bpmnElement="Flow_gw_Realizada_Cerrar_revision">
        <di:waypoint x="655" y="185" />
        <di:waypoint x="655" y="400" />
        <di:waypoint x="830" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Realizada_Cerrar_revision_hacia_Cerrada" bpmnElement="Flow_Realizada_Cerrar_revision_hacia_Cerrada">
        <di:waypoint x="890" y="360" />
        <di:waypoint x="890" y="160" />
        <di:waypoint x="1030" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cerrada_Reabrir_revision_hacia_Realizada" bpmnElement="Flow_Cerrada_Reabrir_revision_hacia_Realizada">
        <di:waypoint x="1030" y="160" />
        <di:waypoint x="680" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
