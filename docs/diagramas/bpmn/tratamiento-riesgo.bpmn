<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Tratamiento_Riesgo" name="Tratamiento Riesgo SGC" processRef="Process_Tratamiento_Riesgo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Tratamiento_Riesgo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Dueno_de_Proceso" name="Dueño de Proceso">
        <bpmn:flowNodeRef>Task_Planificado__Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_ejecucion__Marcar_implementado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Implementado__Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Verificado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Planificado__Iniciar" name="Iniciar">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificado_Iniciar_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_ejecucion__Marcar_implementado" name="Marcar implementado">
      <bpmn:incoming>Flow_Planificado_Iniciar_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_ejecucion_Marcar_implementado_hacia_Implementado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Implementado__Verificar" name="Verificar">
      <bpmn:incoming>Flow_En_ejecucion_Marcar_implementado_hacia_Implementado</bpmn:incoming>
      <bpmn:outgoing>Flow_Implementado_Verificar_hacia_Verificado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Verificado" name="Verificado">
      <bpmn:incoming>Flow_Implementado_Verificar_hacia_Verificado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificado__Iniciar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificado_Iniciar_hacia_En_ejecucion" sourceRef="Task_Planificado__Iniciar" targetRef="Task_En_ejecucion__Marcar_implementado">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_ejecucion_Marcar_implementado_hacia_Implementado" sourceRef="Task_En_ejecucion__Marcar_implementado" targetRef="Task_Implementado__Verificar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Implementado_Verificar_hacia_Verificado" sourceRef="Task_Implementado__Verificar" targetRef="End_Verificado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Tratamiento_Riesgo" bpmnElement="Participant_Tratamiento_Riesgo" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="946" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Dueno_de_Proceso" bpmnElement="Lane_Dueno_de_Proceso" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="916" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="916" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificado__Iniciar" bpmnElement="Task_Planificado__Iniciar">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_ejecucion__Marcar_implementado" bpmnElement="Task_En_ejecucion__Marcar_implementado">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Implementado__Verificar" bpmnElement="Task_Implementado__Verificar">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Verificado" bpmnElement="End_Verificado">
        <dc:Bounds x="1030" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificado_Iniciar_hacia_En_ejecucion" bpmnElement="Flow_Planificado_Iniciar_hacia_En_ejecucion">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_ejecucion_Marcar_implementado_hacia_Implementado" bpmnElement="Flow_En_ejecucion_Marcar_implementado_hacia_Implementado">
        <di:waypoint x="690" y="200" />
        <di:waypoint x="690" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Implementado_Verificar_hacia_Verificado" bpmnElement="Flow_Implementado_Verificar_hacia_Verificado">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
