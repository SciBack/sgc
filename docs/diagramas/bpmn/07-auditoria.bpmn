      <bpmn:outgoing>Flow_Informe_emitido_Cerrar_auditoria_hacia_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Informe_emitido__Reabrir" name="Reabrir">
