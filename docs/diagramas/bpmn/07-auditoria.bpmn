      <bpmn:outgoing>Flow_Ejecutada_Devolver_a_ejecucion_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Informe_emitido__Cerrar_auditoria" name="Cerrar auditoria">
