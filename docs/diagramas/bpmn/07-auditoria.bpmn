    <bpmn:sequenceFlow id="Flow_Ejecutada_Devolver_a_ejecucion_hacia_En_ejecucion" sourceRef="Task_Ejecutada__Devolver_a_ejecucion" targetRef="Task_En_ejecucion__Marcar_ejecutada">
