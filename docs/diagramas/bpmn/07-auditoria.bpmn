    <bpmn:sequenceFlow id="Flow_Planificada_Iniciar_auditoria_hacia_En_ejecucion" sourceRef="Task_Planificada__Iniciar_auditoria" targetRef="Task_En_ejecucion__Marcar_ejecutada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada" sourceRef="Task_En_ejecucion__Marcar_ejecutada" targetRef="Gateway_Ejecutada">
