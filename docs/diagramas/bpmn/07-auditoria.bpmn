      <bpmn:outgoing>Flow_Informe_emitido_Reabrir_hacia_Ejecutada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Ejecutada" name="Ejecutada">
