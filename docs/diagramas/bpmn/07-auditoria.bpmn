<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Auditoria" name="Auditoria SGC" processRef="Process_Auditoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Auditoria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auditor_Interno" name="Auditor Interno">
        <bpmn:flowNodeRef>Task_Planificada__Iniciar_auditoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_ejecucion__Marcar_ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ejecutada__Emitir_informe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ejecutada__Devolver_a_ejecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Informe_emitido__Cerrar_auditoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informe_emitido__Reabrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Informe_emitido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Planificada__Iniciar_auditoria" name="Iniciar auditoria">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada_Iniciar_auditoria_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_ejecucion__Marcar_ejecutada" name="Marcar ejecutada">
      <bpmn:incoming>Flow_Planificada_Iniciar_auditoria_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:incoming>Flow_Ejecutada_Devolver_a_ejecucion_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ejecutada__Emitir_informe" name="Emitir informe">
      <bpmn:incoming>Flow_gw_Ejecutada_Emitir_informe</bpmn:incoming>
      <bpmn:outgoing>Flow_Ejecutada_Emitir_informe_hacia_Informe_emitido</bpmn:outgoing>
