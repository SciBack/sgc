<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Informe_Cumplimiento" name="Informe Cumplimiento SGC" processRef="Process_Informe_Cumplimiento" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Informe_Cumplimiento" isExecutable="false">
    <bpmn:documentation>Diagnóstico anual de las 8 condiciones básicas de calidad del Modelo de Licenciamiento Institucional de la Sunedu, aprobado por la RCD 006-2015-SUNEDU/CD y complementado por la RS 054-2017. Ese es el modelo que aplica a una universidad ya licenciada: el de universidades nuevas (RCD 043-2020, 6 condiciones) no le corresponde, y el de renovación de licencia (RCD 091-2021, 4 condiciones) quedó derogado por la Ley 32105. La base legal del informe está en el artículo 13 de la Ley 30220, Ley Universitaria, en la redacción que le dio esa misma ley: el 13.4 hace la licencia permanente «siempre y cuando las universidades demuestren el cumplimiento continuo de las condiciones básicas de calidad», y el 13.5 nombra «la presentación de informes anuales de cumplimiento» entre las herramientas de la Sunedu. Con la renovación periódica derogada, lo que se demuestra es cumplimiento continuo — por eso este informe es anual y no un trámite que se abre cada varios años.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Borrador__Enviar_a_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_revision__Aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_revision__Observar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aprobado__Observar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_En_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Autoridad_Aprobadora" name="Autoridad Aprobadora">
        <bpmn:flowNodeRef>Task_Aprobado__Presentar_a_SUNEDU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Presentado_a_SUNEDU</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Borrador__Enviar_a_revision" name="Enviar a revision">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_En_revision_Observar_hacia_Borrador</bpmn:incoming>
      <bpmn:incoming>Flow_Aprobado_Observar_hacia_Borrador</bpmn:incoming>
      <bpmn:outgoing>Flow_Borrador_Enviar_a_revision_hacia_En_revision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_revision__Aprobar" name="Aprobar">
      <bpmn:incoming>Flow_gw_En_revision_Aprobar</bpmn:incoming>
      <bpmn:outgoing>Flow_En_revision_Aprobar_hacia_Aprobado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_revision__Observar" name="Observar">
      <bpmn:incoming>Flow_gw_En_revision_Observar</bpmn:incoming>
      <bpmn:outgoing>Flow_En_revision_Observar_hacia_Borrador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Aprobado__Observar" name="Observar">
      <bpmn:incoming>Flow_gw_Aprobado_Observar</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprobado_Observar_hacia_Borrador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Aprobado__Presentar_a_SUNEDU" name="Presentar a SUNEDU">
      <bpmn:incoming>Flow_gw_Aprobado_Presentar_a_SUNEDU</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprobado_Presentar_a_SUNEDU_hacia_Presentado_a_SUNEDU</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_En_revision" name="En revisión">
      <bpmn:incoming>Flow_Borrador_Enviar_a_revision_hacia_En_revision</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_En_revision_Aprobar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_En_revision_Observar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Aprobado" name="Aprobado">
      <bpmn:incoming>Flow_En_revision_Aprobar_hacia_Aprobado</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Aprobado_Observar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Aprobado_Presentar_a_SUNEDU</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Presentado_a_SUNEDU" name="Presentado a SUNEDU">
      <bpmn:incoming>Flow_Aprobado_Presentar_a_SUNEDU_hacia_Presentado_a_SUNEDU</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Borrador__Enviar_a_revision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Borrador_Enviar_a_revision_hacia_En_revision" sourceRef="Task_Borrador__Enviar_a_revision" targetRef="Gateway_En_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_revision_Aprobar" sourceRef="Gateway_En_revision" targetRef="Task_En_revision__Aprobar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision_Aprobar_hacia_Aprobado" sourceRef="Task_En_revision__Aprobar" targetRef="Gateway_Aprobado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_revision_Observar" sourceRef="Gateway_En_revision" targetRef="Task_En_revision__Observar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision_Observar_hacia_Borrador" sourceRef="Task_En_revision__Observar" targetRef="Task_Borrador__Enviar_a_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Aprobado_Observar" sourceRef="Gateway_Aprobado" targetRef="Task_Aprobado__Observar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aprobado_Observar_hacia_Borrador" sourceRef="Task_Aprobado__Observar" targetRef="Task_Borrador__Enviar_a_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Aprobado_Presentar_a_SUNEDU" sourceRef="Gateway_Aprobado" targetRef="Task_Aprobado__Presentar_a_SUNEDU">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aprobado_Presentar_a_SUNEDU_hacia_Presentado_a_SUNEDU" sourceRef="Task_Aprobado__Presentar_a_SUNEDU" targetRef="End_Presentado_a_SUNEDU">
      <bpmn:extensionElements>
        <sgc:transicion rol="Autoridad Aprobadora" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Informe_Cumplimiento" bpmnElement="Participant_Informe_Cumplimiento" isHorizontal="true">
