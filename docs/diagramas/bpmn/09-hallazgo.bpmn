<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hallazgo" name="Hallazgo SGC" processRef="Process_Hallazgo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hallazgo" isExecutable="false">
    <bpmn:documentation>Hallazgo de autoevaluación: lo que la valoración de un criterio deja por debajo de lo esperado. Es una de las entradas al ciclo de mejora que ISO 9001:2015 §10 gobierna como motor único —el mismo para lo que detecta una autoevaluación, una auditoría o un riesgo que se materializa—. Confirmado, escala a «No Conformidad» (§10.2). Quien trata el hallazgo no verifica su eficacia.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>Task_Abierto__Tratar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_tratamiento__Enviar_a_verificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Verificacion__Cerrar_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verificacion__Cerrar_no_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verificacion__Reabrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado_no_eficaz</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Abierto__Tratar" name="Tratar">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Abierto_Tratar_hacia_En_tratamiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_tratamiento__Enviar_a_verificacion" name="Enviar a verificacion">
      <bpmn:incoming>Flow_Abierto_Tratar_hacia_En_tratamiento</bpmn:incoming>
      <bpmn:incoming>Flow_Verificacion_Reabrir_hacia_En_tratamiento</bpmn:incoming>
      <bpmn:outgoing>Flow_En_tratamiento_Enviar_a_verificacion_hacia_Verificacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificacion__Cerrar_eficaz" name="Cerrar eficaz">
      <bpmn:incoming>Flow_gw_Verificacion_Cerrar_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificacion_Cerrar_eficaz_hacia_Cerrado_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificacion__Cerrar_no_eficaz" name="Cerrar no eficaz">
      <bpmn:incoming>Flow_gw_Verificacion_Cerrar_no_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificacion_Cerrar_no_eficaz_hacia_Cerrado_no_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificacion__Reabrir" name="Reabrir">
      <bpmn:incoming>Flow_gw_Verificacion_Reabrir</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificacion_Reabrir_hacia_En_tratamiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verificacion" name="Verificacion">
      <bpmn:incoming>Flow_En_tratamiento_Enviar_a_verificacion_hacia_Verificacion</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Verificacion_Cerrar_eficaz</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Verificacion_Cerrar_no_eficaz</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Verificacion_Reabrir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrado_eficaz" name="Cerrado eficaz">
      <bpmn:incoming>Flow_Verificacion_Cerrar_eficaz_hacia_Cerrado_eficaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cerrado_no_eficaz" name="Cerrado no eficaz">
      <bpmn:incoming>Flow_Verificacion_Cerrar_no_eficaz_hacia_Cerrado_no_eficaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Abierto__Tratar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Abierto_Tratar_hacia_En_tratamiento" sourceRef="Task_Abierto__Tratar" targetRef="Task_En_tratamiento__Enviar_a_verificacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_tratamiento_Enviar_a_verificacion_hacia_Verificacion" sourceRef="Task_En_tratamiento__Enviar_a_verificacion" targetRef="Gateway_Verificacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Verificacion_Cerrar_eficaz" sourceRef="Gateway_Verificacion" targetRef="Task_Verificacion__Cerrar_eficaz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion_Cerrar_eficaz_hacia_Cerrado_eficaz" sourceRef="Task_Verificacion__Cerrar_eficaz" targetRef="End_Cerrado_eficaz">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Verificacion_Cerrar_no_eficaz" sourceRef="Gateway_Verificacion" targetRef="Task_Verificacion__Cerrar_no_eficaz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion_Cerrar_no_eficaz_hacia_Cerrado_no_eficaz" sourceRef="Task_Verificacion__Cerrar_no_eficaz" targetRef="End_Cerrado_no_eficaz">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Verificacion_Reabrir" sourceRef="Gateway_Verificacion" targetRef="Task_Verificacion__Reabrir">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion_Reabrir_hacia_En_tratamiento" sourceRef="Task_Verificacion__Reabrir" targetRef="Task_En_tratamiento__Enviar_a_verificacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Hallazgo" bpmnElement="Participant_Hallazgo" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1238" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1208" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1208" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Abierto__Tratar" bpmnElement="Task_Abierto__Tratar">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_tratamiento__Enviar_a_verificacion" bpmnElement="Task_En_tratamiento__Enviar_a_verificacion">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Verificacion__Cerrar_eficaz" bpmnElement="Task_Verificacion__Cerrar_eficaz">
        <dc:Bounds x="1030" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Verificacion__Cerrar_no_eficaz" bpmnElement="Task_Verificacion__Cerrar_no_eficaz">
        <dc:Bounds x="1030" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Verificacion__Reabrir" bpmnElement="Task_Verificacion__Reabrir">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Verificacion" bpmnElement="Gateway_Verificacion">
        <dc:Bounds x="830" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado_eficaz" bpmnElement="End_Cerrado_eficaz">
        <dc:Bounds x="1322" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado_no_eficaz" bpmnElement="End_Cerrado_no_eficaz">
        <dc:Bounds x="1322" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="312" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="348" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Abierto_Tratar_hacia_En_tratamiento" bpmnElement="Flow_Abierto_Tratar_hacia_En_tratamiento">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_tratamiento_Enviar_a_verificacion_hacia_Verificacion" bpmnElement="Flow_En_tratamiento_Enviar_a_verificacion_hacia_Verificacion">
        <di:waypoint x="690" y="200" />
        <di:waypoint x="690" y="430" />
        <di:waypoint x="830" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Verificacion_Cerrar_eficaz" bpmnElement="Flow_gw_Verificacion_Cerrar_eficaz">
        <di:waypoint x="880" y="430" />
        <di:waypoint x="1030" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion_Cerrar_eficaz_hacia_Cerrado_eficaz" bpmnElement="Flow_Verificacion_Cerrar_eficaz_hacia_Cerrado_eficaz">
        <di:waypoint x="1150" y="430" />
        <di:waypoint x="1322" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Verificacion_Cerrar_no_eficaz" bpmnElement="Flow_gw_Verificacion_Cerrar_no_eficaz">
        <di:waypoint x="855" y="455" />
        <di:waypoint x="855" y="540" />
        <di:waypoint x="1030" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion_Cerrar_no_eficaz_hacia_Cerrado_no_eficaz" bpmnElement="Flow_Verificacion_Cerrar_no_eficaz_hacia_Cerrado_no_eficaz">
        <di:waypoint x="1150" y="540" />
        <di:waypoint x="1322" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Verificacion_Reabrir" bpmnElement="Flow_gw_Verificacion_Reabrir">
        <di:waypoint x="855" y="405" />
        <di:waypoint x="855" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion_Reabrir_hacia_En_tratamiento" bpmnElement="Flow_Verificacion_Reabrir_hacia_En_tratamiento">
        <di:waypoint x="1090" y="280" />
        <di:waypoint x="1090" y="160" />
        <di:waypoint x="750" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
