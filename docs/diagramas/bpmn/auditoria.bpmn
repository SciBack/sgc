<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Auditoria" name="Auditoria SGC" processRef="Process_Auditoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Auditoria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auditor_Interno" name="Auditor Interno">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Planificada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_ejecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informe_emitido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Informe_emitido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Cerrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Planificada" name="Planificada">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada__Iniciar_auditoria</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_ejecucion" name="En ejecucion">
      <bpmn:incoming>Flow_Planificada__Iniciar_auditoria</bpmn:incoming>
      <bpmn:incoming>Flow_Ejecutada__Devolver_a_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_ejecucion__Marcar_ejecutada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ejecutada" name="Ejecutada">
      <bpmn:incoming>Flow_En_ejecucion__Marcar_ejecutada</bpmn:incoming>
      <bpmn:incoming>Flow_Informe_emitido__Reabrir</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Ejecutada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Informe_emitido" name="Informe emitido">
      <bpmn:incoming>Flow_Ejecutada__Emitir_informe</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Informe_emitido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrada" name="Cerrada">
      <bpmn:incoming>Flow_Informe_emitido__Cerrar_auditoria</bpmn:incoming>
      <bpmn:outgoing>Flow_fin_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Ejecutada">
      <bpmn:incoming>Flow_gw_Ejecutada</bpmn:incoming>
      <bpmn:outgoing>Flow_Ejecutada__Emitir_informe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ejecutada__Devolver_a_ejecucion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Informe_emitido">
      <bpmn:incoming>Flow_gw_Informe_emitido</bpmn:incoming>
      <bpmn:outgoing>Flow_Informe_emitido__Cerrar_auditoria</bpmn:outgoing>
      <bpmn:outgoing>Flow_Informe_emitido__Reabrir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrada" name="Fin">
      <bpmn:incoming>Flow_fin_Cerrada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificada__Iniciar_auditoria" sourceRef="Task_Planificada" targetRef="Task_En_ejecucion" name="Iniciar auditoria">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_ejecucion__Marcar_ejecutada" sourceRef="Task_En_ejecucion" targetRef="Task_Ejecutada" name="Marcar ejecutada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Ejecutada" sourceRef="Task_Ejecutada" targetRef="Gateway_Ejecutada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ejecutada__Emitir_informe" sourceRef="Gateway_Ejecutada" targetRef="Task_Informe_emitido" name="Emitir informe">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ejecutada__Devolver_a_ejecucion" sourceRef="Gateway_Ejecutada" targetRef="Task_En_ejecucion" name="Devolver a ejecucion">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Informe_emitido" sourceRef="Task_Informe_emitido" targetRef="Gateway_Informe_emitido">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Informe_emitido__Cerrar_auditoria" sourceRef="Gateway_Informe_emitido" targetRef="Task_Cerrada" name="Cerrar auditoria">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Informe_emitido__Reabrir" sourceRef="Gateway_Informe_emitido" targetRef="Task_Ejecutada" name="Reabrir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fin_Cerrada" sourceRef="Task_Cerrada" targetRef="End_Cerrada">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Auditoria" bpmnElement="Participant_Auditoria" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1346" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Auditor_Interno" bpmnElement="Lane_Auditor_Interno" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificada" bpmnElement="Task_Planificada">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_ejecucion" bpmnElement="Task_En_ejecucion">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Ejecutada" bpmnElement="Task_Ejecutada">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Informe_emitido" bpmnElement="Task_Informe_emitido">
        <dc:Bounds x="1030" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrada" bpmnElement="Task_Cerrada">
        <dc:Bounds x="1230" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Ejecutada" bpmnElement="Gateway_Ejecutada">
        <dc:Bounds x="930" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Informe_emitido" bpmnElement="Gateway_Informe_emitido">
        <dc:Bounds x="1130" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrada" bpmnElement="End_Cerrada">
        <dc:Bounds x="1430" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificada__Iniciar_auditoria" bpmnElement="Flow_Planificada__Iniciar_auditoria">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_ejecucion__Marcar_ejecutada" bpmnElement="Flow_En_ejecucion__Marcar_ejecutada">
        <di:waypoint x="750" y="160" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Ejecutada" bpmnElement="Flow_gw_Ejecutada">
        <di:waypoint x="950" y="160" />
        <di:waypoint x="930" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ejecutada__Emitir_informe" bpmnElement="Flow_Ejecutada__Emitir_informe">
        <di:waypoint x="980" y="160" />
        <di:waypoint x="1030" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ejecutada__Devolver_a_ejecucion" bpmnElement="Flow_Ejecutada__Devolver_a_ejecucion">
        <di:waypoint x="930" y="160" />
        <di:waypoint x="750" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Informe_emitido" bpmnElement="Flow_gw_Informe_emitido">
        <di:waypoint x="1150" y="160" />
        <di:waypoint x="1130" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Informe_emitido__Cerrar_auditoria" bpmnElement="Flow_Informe_emitido__Cerrar_auditoria">
        <di:waypoint x="1180" y="160" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Informe_emitido__Reabrir" bpmnElement="Flow_Informe_emitido__Reabrir">
        <di:waypoint x="1130" y="160" />
        <di:waypoint x="950" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_fin_Cerrada" bpmnElement="Flow_fin_Cerrada">
        <di:waypoint x="1350" y="320" />
        <di:waypoint x="1430" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
