<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Informe_Auditoria" name="Informe Auditoria SGC" processRef="Process_Informe_Auditoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Informe_Auditoria" isExecutable="false">
    <bpmn:documentation>El informe de una auditoría interna. ISO 19011 §6.5 rige su preparación y distribución, y §6.5.1 exige revisarlo y aprobarlo antes de distribuirlo: por eso no lo aprueba quien lo emitió, quien lo creó ni nadie del equipo auditor, y lo aprobado queda congelado — se distribuye lo que se aprobó. Es además una entrada de la revisión por la dirección (ISO 9001:2015 §9.3). Que un hallazgo o la auditoría no se cierren sin el informe aprobado es regla de la casa, no de la norma.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auditor_Interno" name="Auditor Interno">
        <bpmn:flowNodeRef>Task_Borrador__Enviar_a_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_En_revision__Aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_revision__Devolver_a_borrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aprobado__Distribuir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_En_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Distribuido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Borrador__Enviar_a_revision" name="Enviar a revision">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_En_revision_Devolver_a_borrador_hacia_Borrador</bpmn:incoming>
      <bpmn:outgoing>Flow_Borrador_Enviar_a_revision_hacia_En_revision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_revision__Aprobar" name="Aprobar">
      <bpmn:incoming>Flow_gw_En_revision_Aprobar</bpmn:incoming>
      <bpmn:outgoing>Flow_En_revision_Aprobar_hacia_Aprobado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_revision__Devolver_a_borrador" name="Devolver a borrador">
      <bpmn:incoming>Flow_gw_En_revision_Devolver_a_borrador</bpmn:incoming>
      <bpmn:outgoing>Flow_En_revision_Devolver_a_borrador_hacia_Borrador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Aprobado__Distribuir" name="Distribuir">
      <bpmn:incoming>Flow_En_revision_Aprobar_hacia_Aprobado</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprobado_Distribuir_hacia_Distribuido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_En_revision" name="En revision">
      <bpmn:incoming>Flow_Borrador_Enviar_a_revision_hacia_En_revision</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_En_revision_Aprobar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_En_revision_Devolver_a_borrador</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Distribuido" name="Distribuido">
      <bpmn:incoming>Flow_Aprobado_Distribuir_hacia_Distribuido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Borrador__Enviar_a_revision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Borrador_Enviar_a_revision_hacia_En_revision" sourceRef="Task_Borrador__Enviar_a_revision" targetRef="Gateway_En_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_revision_Aprobar" sourceRef="Gateway_En_revision" targetRef="Task_En_revision__Aprobar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision_Aprobar_hacia_Aprobado" sourceRef="Task_En_revision__Aprobar" targetRef="Task_Aprobado__Distribuir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_revision_Devolver_a_borrador" sourceRef="Gateway_En_revision" targetRef="Task_En_revision__Devolver_a_borrador">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_revision_Devolver_a_borrador_hacia_Borrador" sourceRef="Task_En_revision__Devolver_a_borrador" targetRef="Task_Borrador__Enviar_a_revision">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aprobado_Distribuir_hacia_Distribuido" sourceRef="Task_Aprobado__Distribuir" targetRef="End_Distribuido">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Informe_Auditoria" bpmnElement="Participant_Informe_Auditoria" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1346" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Auditor_Interno" bpmnElement="Lane_Auditor_Interno" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1316" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Borrador__Enviar_a_revision" bpmnElement="Task_Borrador__Enviar_a_revision">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_revision__Aprobar" bpmnElement="Task_En_revision__Aprobar">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_revision__Devolver_a_borrador" bpmnElement="Task_En_revision__Devolver_a_borrador">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Aprobado__Distribuir" bpmnElement="Task_Aprobado__Distribuir">
        <dc:Bounds x="1230" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_En_revision" bpmnElement="Gateway_En_revision">
        <dc:Bounds x="630" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Distribuido" bpmnElement="End_Distribuido">
        <dc:Bounds x="1430" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Borrador_Enviar_a_revision_hacia_En_revision" bpmnElement="Flow_Borrador_Enviar_a_revision_hacia_En_revision">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="550" y="295" />
        <di:waypoint x="655" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_revision_Aprobar" bpmnElement="Flow_gw_En_revision_Aprobar">
        <di:waypoint x="680" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_revision_Aprobar_hacia_Aprobado" bpmnElement="Flow_En_revision_Aprobar_hacia_Aprobado">
        <di:waypoint x="890" y="280" />
        <di:waypoint x="1230" y="280" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_revision_Devolver_a_borrador" bpmnElement="Flow_gw_En_revision_Devolver_a_borrador">
        <di:waypoint x="655" y="295" />
        <di:waypoint x="655" y="280" />
        <di:waypoint x="1090" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_revision_Devolver_a_borrador_hacia_Borrador" bpmnElement="Flow_En_revision_Devolver_a_borrador_hacia_Borrador">
        <di:waypoint x="1030" y="320" />
        <di:waypoint x="1030" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Aprobado_Distribuir_hacia_Distribuido" bpmnElement="Flow_Aprobado_Distribuir_hacia_Distribuido">
        <di:waypoint x="1350" y="320" />
        <di:waypoint x="1430" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
