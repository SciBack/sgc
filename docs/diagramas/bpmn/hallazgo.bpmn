<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hallazgo" name="Hallazgo SGC" processRef="Process_Hallazgo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hallazgo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Abierto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_tratamiento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Verificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrado_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrado_no_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado_no_eficaz</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Abierto" name="Abierto">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Abierto__Tratar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_tratamiento" name="En tratamiento">
      <bpmn:incoming>Flow_Abierto__Tratar</bpmn:incoming>
      <bpmn:incoming>Flow_Verificacion__Reabrir</bpmn:incoming>
      <bpmn:outgoing>Flow_En_tratamiento__Enviar_a_verificacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificacion" name="Verificacion">
      <bpmn:incoming>Flow_En_tratamiento__Enviar_a_verificacion</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Verificacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrado_eficaz" name="Cerrado eficaz">
      <bpmn:incoming>Flow_Verificacion__Cerrar_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_fin_Cerrado_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrado_no_eficaz" name="Cerrado no eficaz">
      <bpmn:incoming>Flow_Verificacion__Cerrar_no_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_fin_Cerrado_no_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verificacion">
      <bpmn:incoming>Flow_gw_Verificacion</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificacion__Cerrar_eficaz</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verificacion__Cerrar_no_eficaz</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verificacion__Reabrir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrado_eficaz" name="Fin">
      <bpmn:incoming>Flow_fin_Cerrado_eficaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cerrado_no_eficaz" name="Fin">
      <bpmn:incoming>Flow_fin_Cerrado_no_eficaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Abierto">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Abierto__Tratar" sourceRef="Task_Abierto" targetRef="Task_En_tratamiento" name="Tratar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_tratamiento__Enviar_a_verificacion" sourceRef="Task_En_tratamiento" targetRef="Task_Verificacion" name="Enviar a verificacion">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Verificacion" sourceRef="Task_Verificacion" targetRef="Gateway_Verificacion">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion__Cerrar_eficaz" sourceRef="Gateway_Verificacion" targetRef="Task_Cerrado_eficaz" name="Cerrar eficaz">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion__Cerrar_no_eficaz" sourceRef="Gateway_Verificacion" targetRef="Task_Cerrado_no_eficaz" name="Cerrar no eficaz">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificacion__Reabrir" sourceRef="Gateway_Verificacion" targetRef="Task_En_tratamiento" name="Reabrir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fin_Cerrado_eficaz" sourceRef="Task_Cerrado_eficaz" targetRef="End_Cerrado_eficaz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fin_Cerrado_no_eficaz" sourceRef="Task_Cerrado_no_eficaz" targetRef="End_Cerrado_no_eficaz">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Hallazgo" bpmnElement="Participant_Hallazgo" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1146" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Abierto" bpmnElement="Task_Abierto">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_tratamiento" bpmnElement="Task_En_tratamiento">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Verificacion" bpmnElement="Task_Verificacion">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrado_eficaz" bpmnElement="Task_Cerrado_eficaz">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrado_no_eficaz" bpmnElement="Task_Cerrado_no_eficaz">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Verificacion" bpmnElement="Gateway_Verificacion">
        <dc:Bounds x="930" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado_eficaz" bpmnElement="End_Cerrado_eficaz">
        <dc:Bounds x="1230" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado_no_eficaz" bpmnElement="End_Cerrado_no_eficaz">
        <dc:Bounds x="1230" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Abierto__Tratar" bpmnElement="Flow_Abierto__Tratar">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_tratamiento__Enviar_a_verificacion" bpmnElement="Flow_En_tratamiento__Enviar_a_verificacion">
        <di:waypoint x="750" y="160" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Verificacion" bpmnElement="Flow_gw_Verificacion">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="930" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion__Cerrar_eficaz" bpmnElement="Flow_Verificacion__Cerrar_eficaz">
        <di:waypoint x="980" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion__Cerrar_no_eficaz" bpmnElement="Flow_Verificacion__Cerrar_no_eficaz">
        <di:waypoint x="980" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificacion__Reabrir" bpmnElement="Flow_Verificacion__Reabrir">
        <di:waypoint x="930" y="320" />
        <di:waypoint x="750" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_fin_Cerrado_eficaz" bpmnElement="Flow_fin_Cerrado_eficaz">
        <di:waypoint x="1150" y="320" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_fin_Cerrado_no_eficaz" bpmnElement="Flow_fin_Cerrado_no_eficaz">
        <di:waypoint x="1150" y="320" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
