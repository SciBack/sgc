<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hallazgo_Auditoria" name="Hallazgo Auditoria SGC" processRef="Process_Hallazgo_Auditoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hallazgo_Auditoria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auditor_Interno" name="Auditor Interno">
        <bpmn:flowNodeRef>Task_Abierto__Escalar_a_NC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Abierto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Abierto__Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalado_a_NC__Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrado__Reabrir</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Abierto__Escalar_a_NC" name="Escalar a NC">
      <bpmn:incoming>Flow_gw_Abierto_Escalar_a_NC</bpmn:incoming>
      <bpmn:outgoing>Flow_Abierto_Escalar_a_NC_hacia_Escalado_a_NC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Abierto__Cerrar" name="Cerrar">
      <bpmn:incoming>Flow_gw_Abierto_Cerrar</bpmn:incoming>
      <bpmn:outgoing>Flow_Abierto_Cerrar_hacia_Cerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Escalado_a_NC__Cerrar" name="Cerrar">
      <bpmn:incoming>Flow_Abierto_Escalar_a_NC_hacia_Escalado_a_NC</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalado_a_NC_Cerrar_hacia_Cerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cerrado__Reabrir" name="Reabrir">
      <bpmn:incoming>Flow_Abierto_Cerrar_hacia_Cerrado</bpmn:incoming>
      <bpmn:incoming>Flow_Escalado_a_NC_Cerrar_hacia_Cerrado</bpmn:incoming>
      <bpmn:outgoing>Flow_Cerrado_Reabrir_hacia_Abierto</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Abierto" name="Abierto">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_Cerrado_Reabrir_hacia_Abierto</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Abierto_Escalar_a_NC</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Abierto_Cerrar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Gateway_Abierto">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Abierto_Escalar_a_NC" sourceRef="Gateway_Abierto" targetRef="Task_Abierto__Escalar_a_NC">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Abierto_Escalar_a_NC_hacia_Escalado_a_NC" sourceRef="Task_Abierto__Escalar_a_NC" targetRef="Task_Escalado_a_NC__Cerrar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Abierto_Cerrar" sourceRef="Gateway_Abierto" targetRef="Task_Abierto__Cerrar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Abierto_Cerrar_hacia_Cerrado" sourceRef="Task_Abierto__Cerrar" targetRef="Task_Cerrado__Reabrir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Escalado_a_NC_Cerrar_hacia_Cerrado" sourceRef="Task_Escalado_a_NC__Cerrar" targetRef="Task_Cerrado__Reabrir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cerrado_Reabrir_hacia_Abierto" sourceRef="Task_Cerrado__Reabrir" targetRef="Gateway_Abierto">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Hallazgo_Auditoria" bpmnElement="Participant_Hallazgo_Auditoria" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1030" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Auditor_Interno" bpmnElement="Lane_Auditor_Interno" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1000" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1000" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Abierto__Escalar_a_NC" bpmnElement="Task_Abierto__Escalar_a_NC">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Abierto__Cerrar" bpmnElement="Task_Abierto__Cerrar">
        <dc:Bounds x="630" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Escalado_a_NC__Cerrar" bpmnElement="Task_Escalado_a_NC__Cerrar">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cerrado__Reabrir" bpmnElement="Task_Cerrado__Reabrir">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Abierto" bpmnElement="Gateway_Abierto">
        <dc:Bounds x="430" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="322" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="358" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Abierto_Escalar_a_NC" bpmnElement="Flow_gw_Abierto_Escalar_a_NC">
        <di:waypoint x="480" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Abierto_Escalar_a_NC_hacia_Escalado_a_NC" bpmnElement="Flow_Abierto_Escalar_a_NC_hacia_Escalado_a_NC">
        <di:waypoint x="690" y="200" />
        <di:waypoint x="690" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Abierto_Cerrar" bpmnElement="Flow_gw_Abierto_Cerrar">
        <di:waypoint x="455" y="185" />
        <di:waypoint x="455" y="320" />
        <di:waypoint x="630" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Abierto_Cerrar_hacia_Cerrado" bpmnElement="Flow_Abierto_Cerrar_hacia_Cerrado">
        <di:waypoint x="750" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Escalado_a_NC_Cerrar_hacia_Cerrado" bpmnElement="Flow_Escalado_a_NC_Cerrar_hacia_Cerrado">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cerrado_Reabrir_hacia_Abierto" bpmnElement="Flow_Cerrado_Reabrir_hacia_Abierto">
        <di:waypoint x="1090" y="280" />
        <di:waypoint x="1090" y="160" />
        <di:waypoint x="480" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
