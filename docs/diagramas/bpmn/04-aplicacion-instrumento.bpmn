<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Aplicacion_Instrumento" name="Aplicacion Instrumento SGC" processRef="Process_Aplicacion_Instrumento" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Aplicacion_Instrumento" isExecutable="false">
    <bpmn:documentation>Aplicación de un instrumento de medición —una encuesta, casi siempre— a un grupo de interés en un periodo y un ámbito concretos. Existe porque hay indicadores que no se pueden medir de otro modo: los modelos del Coneau incluyen varios que se evalúan «en opinión de los estudiantes» (el ID19 del modelo de programas mide el porcentaje de docentes con desempeño satisfactorio según ellos), y esa opinión solo se obtiene preguntando. Para los programas en modalidad a distancia hay además una exigencia legal explícita: el artículo 47.4.2, literal d), de la Ley 30220 —en la redacción que le dio la Ley 32105— pide «encuestas periódicas a estudiantes y docentes para evaluar la satisfacción y efectividad» de esa modalidad, «con mecanismos para implementar mejoras basadas en los resultados»; nótese que ese mandato es solo para esa modalidad, no para toda la oferta.

Por eso el ciclo de campo se gobierna y no se deja al criterio de cada quien: cerrar la aplicación FIJA los resultados, y al hacerlo el sistema los publica como valores de indicador que alimentan la acreditación. Ese paso lo ejecuta el sistema solo, al cerrar, y este diagrama todavía no lo dibuja: vive en `resultado_instrumento.publicar_valores_indicador`. Quien cierra no es quien hizo el campo, precisamente porque a partir de ahí el dato deja de ser de la encuesta y pasa a ser del expediente de acreditación.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>Task_Planificada__Iniciar_campo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_En_campo__Devolver_a_planificada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_campo__Cerrar_aplicacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_En_campo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema__automatico_" name="Sistema (automático)">
        <bpmn:flowNodeRef>Efecto_Cerrada__Publicar_valores_de_indicador</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Planificada__Iniciar_campo" name="Iniciar campo">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_En_campo_Devolver_a_planificada_hacia_Planificada</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada_Iniciar_campo_hacia_En_campo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_campo__Devolver_a_planificada" name="Devolver a planificada">
      <bpmn:incoming>Flow_gw_En_campo_Devolver_a_planificada</bpmn:incoming>
      <bpmn:outgoing>Flow_En_campo_Devolver_a_planificada_hacia_Planificada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_campo__Cerrar_aplicacion" name="Cerrar aplicacion">
      <bpmn:incoming>Flow_gw_En_campo_Cerrar_aplicacion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_campo_Cerrar_aplicacion_hacia_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_En_campo" name="En campo">
      <bpmn:incoming>Flow_Planificada_Iniciar_campo_hacia_En_campo</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_En_campo_Devolver_a_planificada</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_En_campo_Cerrar_aplicacion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrada" name="Cerrada">
      <bpmn:incoming>Flow_efecto_Cerrada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Efecto_Cerrada__Publicar_valores_de_indicador" name="Publicar valores de indicador">
      <bpmn:incoming>Flow_En_campo_Cerrar_aplicacion_hacia_Cerrada</bpmn:incoming>
      <bpmn:outgoing>Flow_efecto_Cerrada</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificada__Iniciar_campo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificada_Iniciar_campo_hacia_En_campo" sourceRef="Task_Planificada__Iniciar_campo" targetRef="Gateway_En_campo">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_campo_Devolver_a_planificada" sourceRef="Gateway_En_campo" targetRef="Task_En_campo__Devolver_a_planificada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_campo_Devolver_a_planificada_hacia_Planificada" sourceRef="Task_En_campo__Devolver_a_planificada" targetRef="Task_Planificada__Iniciar_campo">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_En_campo_Cerrar_aplicacion" sourceRef="Gateway_En_campo" targetRef="Task_En_campo__Cerrar_aplicacion">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_campo_Cerrar_aplicacion_hacia_Cerrada" sourceRef="Task_En_campo__Cerrar_aplicacion" targetRef="Efecto_Cerrada__Publicar_valores_de_indicador">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_efecto_Cerrada" sourceRef="Efecto_Cerrada__Publicar_valores_de_indicador" targetRef="End_Cerrada">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Aplicacion_Instrumento" bpmnElement="Participant_Aplicacion_Instrumento" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1146" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sistema__automatico_" bpmnElement="Lane_Sistema__automatico_" isHorizontal="true">
        <dc:Bounds x="230" y="400" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificada__Iniciar_campo" bpmnElement="Task_Planificada__Iniciar_campo">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_campo__Devolver_a_planificada" bpmnElement="Task_En_campo__Devolver_a_planificada">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_campo__Cerrar_aplicacion" bpmnElement="Task_En_campo__Cerrar_aplicacion">
        <dc:Bounds x="1030" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_En_campo" bpmnElement="Gateway_En_campo">
        <dc:Bounds x="630" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrada" bpmnElement="End_Cerrada">
        <dc:Bounds x="1230" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="302" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Efecto_Cerrada__Publicar_valores_de_indicador" bpmnElement="Efecto_Cerrada__Publicar_valores_de_indicador">
        <dc:Bounds x="1072" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="338" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificada_Iniciar_campo_hacia_En_campo" bpmnElement="Flow_Planificada_Iniciar_campo_hacia_En_campo">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="490" y="320" />
        <di:waypoint x="630" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_campo_Devolver_a_planificada" bpmnElement="Flow_gw_En_campo_Devolver_a_planificada">
        <di:waypoint x="680" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_campo_Devolver_a_planificada_hacia_Planificada" bpmnElement="Flow_En_campo_Devolver_a_planificada_hacia_Planificada">
        <di:waypoint x="890" y="280" />
        <di:waypoint x="890" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_campo_Cerrar_aplicacion" bpmnElement="Flow_gw_En_campo_Cerrar_aplicacion">
        <di:waypoint x="680" y="320" />
        <di:waypoint x="1030" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_campo_Cerrar_aplicacion_hacia_Cerrada" bpmnElement="Flow_En_campo_Cerrar_aplicacion_hacia_Cerrada">
        <di:waypoint x="1090" y="360" />
        <di:waypoint x="1090" y="480" />
        <di:waypoint x="1072" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_efecto_Cerrada" bpmnElement="Flow_efecto_Cerrada">
        <di:waypoint x="1090" y="462" />
        <di:waypoint x="1090" y="320" />
        <di:waypoint x="1230" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
