<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Riesgo" name="Riesgo SGC" processRef="Process_Riesgo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Riesgo" isExecutable="false">
    <bpmn:documentation>Inventario de riesgos. ISO 9001:2015 §6.1 obliga a determinar y abordar los riesgos y oportunidades capaces de afectar al sistema de gestión; identificarlos, analizarlos y valorarlos es el proceso de ISO 31000 (§6.4.2 para la identificación). Un riesgo que se materializa no se cierra: entra al ciclo de mejora como no conformidad (ISO 9001:2015 §10.2), y por eso confirmar la materialización es un control y no un avance más del propio dueño del riesgo.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Dueno_de_Proceso" name="Dueño de Proceso">
        <bpmn:flowNodeRef>Task_Identificado__Evaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluado__Iniciar_tratamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_tratamiento__Monitorear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Monitoreado__Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitoreado__Materializar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Materializado__Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Monitoreado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Identificado__Evaluar" name="Evaluar">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Identificado_Evaluar_hacia_Evaluado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Evaluado__Iniciar_tratamiento" name="Iniciar tratamiento">
      <bpmn:incoming>Flow_Identificado_Evaluar_hacia_Evaluado</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluado_Iniciar_tratamiento_hacia_En_tratamiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_tratamiento__Monitorear" name="Monitorear">
      <bpmn:incoming>Flow_Evaluado_Iniciar_tratamiento_hacia_En_tratamiento</bpmn:incoming>
      <bpmn:outgoing>Flow_En_tratamiento_Monitorear_hacia_Monitoreado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Monitoreado__Cerrar" name="Cerrar">
      <bpmn:incoming>Flow_gw_Monitoreado_Cerrar</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitoreado_Cerrar_hacia_Cerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Monitoreado__Materializar" name="Materializar">
      <bpmn:incoming>Flow_gw_Monitoreado_Materializar</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitoreado_Materializar_hacia_Materializado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Materializado__Cerrar" name="Cerrar">
      <bpmn:incoming>Flow_Monitoreado_Materializar_hacia_Materializado</bpmn:incoming>
      <bpmn:outgoing>Flow_Materializado_Cerrar_hacia_Cerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Monitoreado" name="Monitoreado">
      <bpmn:incoming>Flow_En_tratamiento_Monitorear_hacia_Monitoreado</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Monitoreado_Cerrar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Monitoreado_Materializar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrado" name="Cerrado">
      <bpmn:incoming>Flow_Monitoreado_Cerrar_hacia_Cerrado</bpmn:incoming>
      <bpmn:incoming>Flow_Materializado_Cerrar_hacia_Cerrado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Identificado__Evaluar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Identificado_Evaluar_hacia_Evaluado" sourceRef="Task_Identificado__Evaluar" targetRef="Task_Evaluado__Iniciar_tratamiento">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Evaluado_Iniciar_tratamiento_hacia_En_tratamiento" sourceRef="Task_Evaluado__Iniciar_tratamiento" targetRef="Task_En_tratamiento__Monitorear">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_tratamiento_Monitorear_hacia_Monitoreado" sourceRef="Task_En_tratamiento__Monitorear" targetRef="Gateway_Monitoreado">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Monitoreado_Cerrar" sourceRef="Gateway_Monitoreado" targetRef="Task_Monitoreado__Cerrar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Monitoreado_Cerrar_hacia_Cerrado" sourceRef="Task_Monitoreado__Cerrar" targetRef="End_Cerrado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Monitoreado_Materializar" sourceRef="Gateway_Monitoreado" targetRef="Task_Monitoreado__Materializar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Monitoreado_Materializar_hacia_Materializado" sourceRef="Task_Monitoreado__Materializar" targetRef="Task_Materializado__Cerrar">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Materializado_Cerrar_hacia_Cerrado" sourceRef="Task_Materializado__Cerrar" targetRef="End_Cerrado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Riesgo" bpmnElement="Participant_Riesgo" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1586" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Dueno_de_Proceso" bpmnElement="Lane_Dueno_de_Proceso" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1556" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1556" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Identificado__Evaluar" bpmnElement="Task_Identificado__Evaluar">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Evaluado__Iniciar_tratamiento" bpmnElement="Task_Evaluado__Iniciar_tratamiento">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_tratamiento__Monitorear" bpmnElement="Task_En_tratamiento__Monitorear">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Monitoreado__Cerrar" bpmnElement="Task_Monitoreado__Cerrar">
        <dc:Bounds x="1070" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Monitoreado__Materializar" bpmnElement="Task_Monitoreado__Materializar">
        <dc:Bounds x="1270" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Materializado__Cerrar" bpmnElement="Task_Materializado__Cerrar">
        <dc:Bounds x="1470" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Monitoreado" bpmnElement="Gateway_Monitoreado">
        <dc:Bounds x="865" y="345" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado" bpmnElement="End_Cerrado">
        <dc:Bounds x="1670" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="312" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="348" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Identificado_Evaluar_hacia_Evaluado" bpmnElement="Flow_Identificado_Evaluar_hacia_Evaluado">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Evaluado_Iniciar_tratamiento_hacia_En_tratamiento" bpmnElement="Flow_Evaluado_Iniciar_tratamiento_hacia_En_tratamiento">
        <di:waypoint x="750" y="160" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_tratamiento_Monitorear_hacia_Monitoreado" bpmnElement="Flow_En_tratamiento_Monitorear_hacia_Monitoreado">
        <di:waypoint x="890" y="200" />
        <di:waypoint x="890" y="370" />
        <di:waypoint x="865" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Monitoreado_Cerrar" bpmnElement="Flow_gw_Monitoreado_Cerrar">
        <di:waypoint x="915" y="370" />
        <di:waypoint x="1070" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Monitoreado_Cerrar_hacia_Cerrado" bpmnElement="Flow_Monitoreado_Cerrar_hacia_Cerrado">
        <di:waypoint x="1190" y="370" />
        <di:waypoint x="1670" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Monitoreado_Materializar" bpmnElement="Flow_gw_Monitoreado_Materializar">
        <di:waypoint x="915" y="370" />
        <di:waypoint x="1270" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Monitoreado_Materializar_hacia_Materializado" bpmnElement="Flow_Monitoreado_Materializar_hacia_Materializado">
        <di:waypoint x="1390" y="370" />
        <di:waypoint x="1470" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Materializado_Cerrar_hacia_Cerrado" bpmnElement="Flow_Materializado_Cerrar_hacia_Cerrado">
        <di:waypoint x="1590" y="370" />
        <di:waypoint x="1670" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
