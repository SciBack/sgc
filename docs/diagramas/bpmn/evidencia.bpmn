<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Evidencia" name="Evidencia SGC" processRef="Process_Evidencia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Evidencia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Subsanada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Subsanada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Valida</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista_de_Calidad__DPGC_" name="Analista de Calidad (DPGC)">
        <bpmn:flowNodeRef>Task_Observada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Observada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Pendiente" name="Pendiente">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Pendiente</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Valida" name="Valida">
      <bpmn:incoming>Flow_Pendiente__Validar</bpmn:incoming>
      <bpmn:incoming>Flow_Subsanada__Validar</bpmn:incoming>
      <bpmn:outgoing>Flow_fin_Valida</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Observada" name="Observada">
      <bpmn:incoming>Flow_Pendiente__Observar</bpmn:incoming>
      <bpmn:incoming>Flow_Subsanada__Observar</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Observada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Subsanada" name="Subsanada">
      <bpmn:incoming>Flow_Observada__Subsanar</bpmn:incoming>
      <bpmn:incoming>Flow_Observada__Subsanar_2</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Subsanada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Pendiente">
      <bpmn:incoming>Flow_gw_Pendiente</bpmn:incoming>
      <bpmn:outgoing>Flow_Pendiente__Validar</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pendiente__Observar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Valida" name="Fin">
      <bpmn:incoming>Flow_fin_Valida</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Observada">
      <bpmn:incoming>Flow_gw_Observada</bpmn:incoming>
      <bpmn:outgoing>Flow_Observada__Subsanar</bpmn:outgoing>
      <bpmn:outgoing>Flow_Observada__Subsanar_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Subsanada">
      <bpmn:incoming>Flow_gw_Subsanada</bpmn:incoming>
      <bpmn:outgoing>Flow_Subsanada__Validar</bpmn:outgoing>
      <bpmn:outgoing>Flow_Subsanada__Observar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Pendiente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Pendiente" sourceRef="Task_Pendiente" targetRef="Gateway_Pendiente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pendiente__Validar" sourceRef="Gateway_Pendiente" targetRef="Task_Valida" name="Validar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pendiente__Observar" sourceRef="Gateway_Pendiente" targetRef="Task_Observada" name="Observar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fin_Valida" sourceRef="Task_Valida" targetRef="End_Valida">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Observada" sourceRef="Task_Observada" targetRef="Gateway_Observada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Observada__Subsanar" sourceRef="Gateway_Observada" targetRef="Task_Subsanada" name="Subsanar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Observada__Subsanar_2" sourceRef="Gateway_Observada" targetRef="Task_Subsanada" name="Subsanar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Subsanada" sourceRef="Task_Subsanada" targetRef="Gateway_Subsanada">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Subsanada__Validar" sourceRef="Gateway_Subsanada" targetRef="Task_Valida" name="Validar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Subsanada__Observar" sourceRef="Gateway_Subsanada" targetRef="Task_Observada" name="Observar">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Evidencia" bpmnElement="Participant_Evidencia" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="860.0" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="830.0" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="830.0" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Analista_de_Calidad__DPGC_" bpmnElement="Lane_Analista_de_Calidad__DPGC_" isHorizontal="true">
        <dc:Bounds x="230" y="400" width="830.0" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Pendiente" bpmnElement="Task_Pendiente">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Valida" bpmnElement="Task_Valida">
        <dc:Bounds x="630" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Observada" bpmnElement="Task_Observada">
        <dc:Bounds x="630" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Subsanada" bpmnElement="Task_Subsanada">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Pendiente" bpmnElement="Gateway_Pendiente">
        <dc:Bounds x="530" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Valida" bpmnElement="End_Valida">
        <dc:Bounds x="830" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Observada" bpmnElement="Gateway_Observada">
        <dc:Bounds x="730" y="455" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Subsanada" bpmnElement="Gateway_Subsanada">
        <dc:Bounds x="930" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Pendiente" bpmnElement="Flow_gw_Pendiente">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="530" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Pendiente__Validar" bpmnElement="Flow_Pendiente__Validar">
        <di:waypoint x="580" y="160" />
        <di:waypoint x="630" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Pendiente__Observar" bpmnElement="Flow_Pendiente__Observar">
        <di:waypoint x="580" y="160" />
        <di:waypoint x="630" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_fin_Valida" bpmnElement="Flow_fin_Valida">
        <di:waypoint x="750" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Observada" bpmnElement="Flow_gw_Observada">
        <di:waypoint x="750" y="480" />
        <di:waypoint x="730" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Observada__Subsanar" bpmnElement="Flow_Observada__Subsanar">
