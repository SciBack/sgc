        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Observada__Subsanar_2" bpmnElement="Flow_Observada__Subsanar_2">
        <di:waypoint x="780" y="480" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Subsanada" bpmnElement="Flow_gw_Subsanada">
        <di:waypoint x="950" y="160" />
        <di:waypoint x="930" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Subsanada__Validar" bpmnElement="Flow_Subsanada__Validar">
        <di:waypoint x="930" y="160" />
        <di:waypoint x="750" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Subsanada__Observar" bpmnElement="Flow_Subsanada__Observar">
