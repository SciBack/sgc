        <di:waypoint x="890" y="120" />
        <di:waypoint x="1230" y="120" />
        <di:waypoint x="1230" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_evaluacion_Descartar" bpmnElement="Flow_gw_En_evaluacion_Descartar">
        <di:waypoint x="655" y="135" />
        <di:waypoint x="655" y="120" />
        <di:waypoint x="1090" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_evaluacion_Descartar_hacia_Descartado" bpmnElement="Flow_En_evaluacion_Descartar_hacia_Descartado">
        <di:waypoint x="1150" y="160" />
        <di:waypoint x="1150" y="142" />
