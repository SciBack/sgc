      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Confirmado" bpmnElement="End_Confirmado">
        <dc:Bounds x="1230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Descartado" bpmnElement="End_Descartado">
        <dc:Bounds x="1430" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_No_Conformidad" bpmnElement="Participant_No_Conformidad" isHorizontal="true">
        <dc:Bounds x="200" y="300" width="1346" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Msg_Confirmar__No_Conformidad" bpmnElement="Msg_Confirmar__No_Conformidad">
        <di:waypoint x="890" y="200" />
        <di:waypoint x="890" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Reportado_Evaluar_hacia_En_evaluacion" bpmnElement="Flow_Reportado_Evaluar_hacia_En_evaluacion">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_En_evaluacion_Confirmar" bpmnElement="Flow_gw_En_evaluacion_Confirmar">
        <di:waypoint x="680" y="160" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
