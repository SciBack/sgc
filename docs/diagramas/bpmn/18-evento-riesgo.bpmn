      <bpmndi:BPMNShape id="Shape_Task_Reportado__Evaluar" bpmnElement="Task_Reportado__Evaluar">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_evaluacion__Confirmar" bpmnElement="Task_En_evaluacion__Confirmar">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_evaluacion__Descartar" bpmnElement="Task_En_evaluacion__Descartar">
        <dc:Bounds x="1030" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_En_evaluacion" bpmnElement="Gateway_En_evaluacion">
