<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Accion_Mejora" name="Accion de Mejora SGC" processRef="Process_Accion_Mejora" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Accion_Mejora" isExecutable="false">
    <bpmn:documentation>Cada acción concreta de un plan de mejora. Los dos desenlaces verificados —eficaz y no eficaz— son lo que ISO 9001:2015 §10.2 llama revisar la eficacia de la acción correctiva: una acción que se ejecutó pero no eliminó la causa no cierra el ciclo, y el proceso tiene que poder registrarlo.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>Task_Planificada__Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_ejecucion__Marcar_ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Ejecutada__Verificar_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ejecutada__Verificar_no_eficaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verificada_no_eficaz__Reabrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ejecutada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Verificada_eficaz</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Planificada__Iniciar" name="Iniciar">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Planificada_Iniciar_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_ejecucion__Marcar_ejecutada" name="Marcar ejecutada">
      <bpmn:incoming>Flow_Planificada_Iniciar_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:incoming>Flow_Verificada_no_eficaz_Reabrir_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ejecutada__Verificar_eficaz" name="Verificar eficaz">
      <bpmn:incoming>Flow_gw_Ejecutada_Verificar_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_Ejecutada_Verificar_eficaz_hacia_Verificada_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ejecutada__Verificar_no_eficaz" name="Verificar no eficaz">
      <bpmn:incoming>Flow_gw_Ejecutada_Verificar_no_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_Ejecutada_Verificar_no_eficaz_hacia_Verificada_no_eficaz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificada_no_eficaz__Reabrir" name="Reabrir">
      <bpmn:incoming>Flow_Ejecutada_Verificar_no_eficaz_hacia_Verificada_no_eficaz</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificada_no_eficaz_Reabrir_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Ejecutada" name="Ejecutada">
      <bpmn:incoming>Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Ejecutada_Verificar_eficaz</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Ejecutada_Verificar_no_eficaz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Verificada_eficaz" name="Verificada eficaz">
      <bpmn:incoming>Flow_Ejecutada_Verificar_eficaz_hacia_Verificada_eficaz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Planificada__Iniciar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Planificada_Iniciar_hacia_En_ejecucion" sourceRef="Task_Planificada__Iniciar" targetRef="Task_En_ejecucion__Marcar_ejecutada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada" sourceRef="Task_En_ejecucion__Marcar_ejecutada" targetRef="Gateway_Ejecutada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Ejecutada_Verificar_eficaz" sourceRef="Gateway_Ejecutada" targetRef="Task_Ejecutada__Verificar_eficaz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ejecutada_Verificar_eficaz_hacia_Verificada_eficaz" sourceRef="Task_Ejecutada__Verificar_eficaz" targetRef="End_Verificada_eficaz">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Ejecutada_Verificar_no_eficaz" sourceRef="Gateway_Ejecutada" targetRef="Task_Ejecutada__Verificar_no_eficaz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ejecutada_Verificar_no_eficaz_hacia_Verificada_no_eficaz" sourceRef="Task_Ejecutada__Verificar_no_eficaz" targetRef="Task_Verificada_no_eficaz__Reabrir">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verificada_no_eficaz_Reabrir_hacia_En_ejecucion" sourceRef="Task_Verificada_no_eficaz__Reabrir" targetRef="Task_En_ejecucion__Marcar_ejecutada">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Accion_Mejora" bpmnElement="Participant_Accion_Mejora" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1546" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Responsable_de_Calidad_de_Programa" bpmnElement="Lane_Responsable_de_Calidad_de_Programa" isHorizontal="true">
        <dc:Bounds x="230" y="80" width="1516" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_DPGC" bpmnElement="Lane_DPGC" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1516" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Planificada__Iniciar" bpmnElement="Task_Planificada__Iniciar">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_ejecucion__Marcar_ejecutada" bpmnElement="Task_En_ejecucion__Marcar_ejecutada">
        <dc:Bounds x="630" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Ejecutada__Verificar_eficaz" bpmnElement="Task_Ejecutada__Verificar_eficaz">
        <dc:Bounds x="1030" y="302" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Ejecutada__Verificar_no_eficaz" bpmnElement="Task_Ejecutada__Verificar_no_eficaz">
        <dc:Bounds x="1230" y="302" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Verificada_no_eficaz__Reabrir" bpmnElement="Task_Verificada_no_eficaz__Reabrir">
        <dc:Bounds x="1430" y="302" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Ejecutada" bpmnElement="Gateway_Ejecutada">
        <dc:Bounds x="830" y="317" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Verificada_eficaz" bpmnElement="End_Verificada_eficaz">
        <dc:Bounds x="1630" y="324" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="302" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="338" y="160" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Planificada_Iniciar_hacia_En_ejecucion" bpmnElement="Flow_Planificada_Iniciar_hacia_En_ejecucion">
        <di:waypoint x="550" y="160" />
        <di:waypoint x="630" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada" bpmnElement="Flow_En_ejecucion_Marcar_ejecutada_hacia_Ejecutada">
        <di:waypoint x="690" y="200" />
        <di:waypoint x="690" y="342" />
        <di:waypoint x="830" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Ejecutada_Verificar_eficaz" bpmnElement="Flow_gw_Ejecutada_Verificar_eficaz">
        <di:waypoint x="880" y="342" />
        <di:waypoint x="1030" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ejecutada_Verificar_eficaz_hacia_Verificada_eficaz" bpmnElement="Flow_Ejecutada_Verificar_eficaz_hacia_Verificada_eficaz">
        <di:waypoint x="1150" y="342" />
        <di:waypoint x="1630" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Ejecutada_Verificar_no_eficaz" bpmnElement="Flow_gw_Ejecutada_Verificar_no_eficaz">
        <di:waypoint x="880" y="342" />
        <di:waypoint x="1230" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ejecutada_Verificar_no_eficaz_hacia_Verificada_no_eficaz" bpmnElement="Flow_Ejecutada_Verificar_no_eficaz_hacia_Verificada_no_eficaz">
        <di:waypoint x="1350" y="342" />
        <di:waypoint x="1430" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Verificada_no_eficaz_Reabrir_hacia_En_ejecucion" bpmnElement="Flow_Verificada_no_eficaz_Reabrir_hacia_En_ejecucion">
        <di:waypoint x="1490" y="302" />
        <di:waypoint x="1490" y="160" />
        <di:waypoint x="750" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
