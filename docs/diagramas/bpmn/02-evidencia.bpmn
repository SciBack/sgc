<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Evidencia" name="Evidencia SGC" processRef="Process_Evidencia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Evidencia" isExecutable="false">
    <bpmn:documentation>Base probatoria de todo lo demás: sin evidencia validada, una valoración o un diagnóstico no se sostiene ante nadie. Los modelos de acreditación del Coneau —el órgano que acredita, dentro del Sineace— enumeran la evidencia esperada criterio por criterio: 52 evidencias en el modelo de programas de estudios (Tabla 8) y 84 en el institucional. Para el licenciamiento, en cambio, qué medio de verificación admite la Sunedu por indicador NO está verificado contra fuente primaria y por tanto no se afirma aquí.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Analista_de_Calidad__DPGC_" name="Analista de Calidad (DPGC)">
        <bpmn:flowNodeRef>Task_Pendiente__Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pendiente__Observar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Subsanada__Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Subsanada__Observar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Subsanada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valida_espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Responsable_de_Calidad_de_Programa" name="Responsable de Calidad de Programa">
        <bpmn:flowNodeRef>Task_Observada__Subsanar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Observada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dueno_de_Proceso" name="Dueño de Proceso">
        <bpmn:flowNodeRef>Task_Observada__Subsanar_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema__automatico_" name="Sistema (automático)">
        <bpmn:flowNodeRef>Auto_Pendiente__Vencida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Vencida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auto_Valida__Vencida</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Pendiente__Validar" name="Validar">
      <bpmn:incoming>Flow_gw_Pendiente_Validar</bpmn:incoming>
      <bpmn:outgoing>Flow_Pendiente_Validar_hacia_Valida</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pendiente__Observar" name="Observar">
      <bpmn:incoming>Flow_gw_Pendiente_Observar</bpmn:incoming>
      <bpmn:outgoing>Flow_Pendiente_Observar_hacia_Observada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Observada__Subsanar" name="Subsanar">
      <bpmn:incoming>Flow_gw_Observada_Subsanar</bpmn:incoming>
      <bpmn:outgoing>Flow_Observada_Subsanar_hacia_Subsanada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Observada__Subsanar_2" name="Subsanar">
      <bpmn:incoming>Flow_gw_Observada_Subsanar_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Observada_Subsanar_hacia_Subsanada_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Subsanada__Validar" name="Validar">
      <bpmn:incoming>Flow_gw_Subsanada_Validar</bpmn:incoming>
      <bpmn:outgoing>Flow_Subsanada_Validar_hacia_Valida</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Subsanada__Observar" name="Observar">
      <bpmn:incoming>Flow_gw_Subsanada_Observar</bpmn:incoming>
      <bpmn:outgoing>Flow_Subsanada_Observar_hacia_Observada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Pendiente" name="Pendiente">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_auto_in_Pendiente_Vencida</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Pendiente_Validar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Pendiente_Observar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Observada" name="Observada">
      <bpmn:incoming>Flow_Pendiente_Observar_hacia_Observada</bpmn:incoming>
      <bpmn:incoming>Flow_Subsanada_Observar_hacia_Observada</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Observada_Subsanar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Observada_Subsanar_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Subsanada" name="Subsanada">
      <bpmn:incoming>Flow_Observada_Subsanar_hacia_Subsanada</bpmn:incoming>
      <bpmn:incoming>Flow_Observada_Subsanar_hacia_Subsanada_2</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Subsanada_Validar</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Subsanada_Observar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Valida" name="Valida">
      <bpmn:incoming>Flow_Valida_sigue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Valida_espera" name="Valida">
      <bpmn:incoming>Flow_Pendiente_Validar_hacia_Valida</bpmn:incoming>
      <bpmn:incoming>Flow_Subsanada_Validar_hacia_Valida</bpmn:incoming>
      <bpmn:outgoing>Flow_Valida_sigue</bpmn:outgoing>
      <bpmn:outgoing>Flow_auto_in_Valida_Vencida</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Auto_Pendiente__Vencida" name="Vence la vigencia">
      <bpmn:incoming>Flow_auto_in_Pendiente_Vencida</bpmn:incoming>
      <bpmn:outgoing>Flow_auto_out_Pendiente_Vencida</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Auto_Pendiente__Vencida" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Vencida" name="Vencida">
      <bpmn:incoming>Flow_auto_out_Pendiente_Vencida</bpmn:incoming>
      <bpmn:incoming>Flow_auto_out_Valida_Vencida</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Auto_Valida__Vencida" name="Vence la vigencia">
      <bpmn:incoming>Flow_auto_in_Valida_Vencida</bpmn:incoming>
      <bpmn:outgoing>Flow_auto_out_Valida_Vencida</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Auto_Valida__Vencida" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_Valida_sigue" sourceRef="Gateway_Valida_espera" targetRef="End_Valida" name="Sigue vigente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Gateway_Pendiente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auto_in_Pendiente_Vencida" sourceRef="Gateway_Pendiente" targetRef="Auto_Pendiente__Vencida">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auto_out_Pendiente_Vencida" sourceRef="Auto_Pendiente__Vencida" targetRef="End_Vencida">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auto_in_Valida_Vencida" sourceRef="Gateway_Valida_espera" targetRef="Auto_Valida__Vencida">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auto_out_Valida_Vencida" sourceRef="Auto_Valida__Vencida" targetRef="End_Vencida">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Pendiente_Validar" sourceRef="Gateway_Pendiente" targetRef="Task_Pendiente__Validar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pendiente_Validar_hacia_Valida" sourceRef="Task_Pendiente__Validar" targetRef="Gateway_Valida_espera">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Pendiente_Observar" sourceRef="Gateway_Pendiente" targetRef="Task_Pendiente__Observar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pendiente_Observar_hacia_Observada" sourceRef="Task_Pendiente__Observar" targetRef="Gateway_Observada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Observada_Subsanar" sourceRef="Gateway_Observada" targetRef="Task_Observada__Subsanar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Observada_Subsanar_hacia_Subsanada" sourceRef="Task_Observada__Subsanar" targetRef="Gateway_Subsanada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Responsable de Calidad de Programa" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Observada_Subsanar_2" sourceRef="Gateway_Observada" targetRef="Task_Observada__Subsanar_2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Observada_Subsanar_hacia_Subsanada_2" sourceRef="Task_Observada__Subsanar_2" targetRef="Gateway_Subsanada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Dueño de Proceso" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Subsanada_Validar" sourceRef="Gateway_Subsanada" targetRef="Task_Subsanada__Validar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Subsanada_Validar_hacia_Valida" sourceRef="Task_Subsanada__Validar" targetRef="Gateway_Valida_espera">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Subsanada_Observar" sourceRef="Gateway_Subsanada" targetRef="Task_Subsanada__Observar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Subsanada_Observar_hacia_Observada" sourceRef="Task_Subsanada__Observar" targetRef="Gateway_Observada">
      <bpmn:extensionElements>
        <sgc:transicion rol="Analista de Calidad (DPGC)" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
