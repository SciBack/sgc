      <bpmn:outgoing>Flow_Verificada_Cerrar_hacia_Cerrada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Detectada_5" name="Detectada">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Detectada_Iniciar_tratamiento</bpmn:outgoing>
