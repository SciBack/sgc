      <bpmn:outgoing>Flow_En_tratamiento_Registrar_tratamiento_hacia_Tratada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_tratamiento__Registrar_tratamiento_2" name="Registrar tratamiento">
      <bpmn:incoming>Flow_gw_En_tratamiento_Registrar_tratamiento_2</bpmn:incoming>
      <bpmn:outgoing>Flow_En_tratamiento_Registrar_tratamiento_hacia_Tratada_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Tratada__Verificar" name="Verificar">
      <bpmn:incoming>Flow_gw_Tratada_Verificar</bpmn:incoming>
      <bpmn:outgoing>Flow_Tratada_Verificar_hacia_Verificada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Tratada__Devolver_a_tratamiento" name="Devolver a tratamiento">
      <bpmn:incoming>Flow_gw_Tratada_Devolver_a_tratamiento</bpmn:incoming>
      <bpmn:outgoing>Flow_Tratada_Devolver_a_tratamiento_hacia_En_tratamiento</bpmn:outgoing>
