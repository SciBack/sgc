<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sgc="https://sciback.com/schema/sgc/1.0" id="Definitions_1" targetNamespace="https://sciback.com/schema/sgc/1.0" exporter="SGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Programa_Auditoria" name="Programa Auditoria SGC" processRef="Process_Programa_Auditoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Programa_Auditoria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_DPGC" name="DPGC">
        <bpmn:flowNodeRef>Task_Borrador__Aprobar_programa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aprobado__Devolver_a_borrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_En_ejecucion__Cerrar_programa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auditor_Interno" name="Auditor Interno">
        <bpmn:flowNodeRef>Task_Aprobado__Iniciar_ejecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Borrador__Aprobar_programa" name="Aprobar programa">
      <bpmn:incoming>Flow_inicio</bpmn:incoming>
      <bpmn:incoming>Flow_Aprobado_Devolver_a_borrador_hacia_Borrador</bpmn:incoming>
      <bpmn:outgoing>Flow_Borrador_Aprobar_programa_hacia_Aprobado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Aprobado__Iniciar_ejecucion" name="Iniciar ejecucion">
      <bpmn:incoming>Flow_gw_Aprobado_Iniciar_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprobado_Iniciar_ejecucion_hacia_En_ejecucion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Aprobado__Devolver_a_borrador" name="Devolver a borrador">
      <bpmn:incoming>Flow_gw_Aprobado_Devolver_a_borrador</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprobado_Devolver_a_borrador_hacia_Borrador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_En_ejecucion__Cerrar_programa" name="Cerrar programa">
      <bpmn:incoming>Flow_Aprobado_Iniciar_ejecucion_hacia_En_ejecucion</bpmn:incoming>
      <bpmn:outgoing>Flow_En_ejecucion_Cerrar_programa_hacia_Cerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobado" name="Aprobado">
      <bpmn:incoming>Flow_Borrador_Aprobar_programa_hacia_Aprobado</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_Aprobado_Iniciar_ejecucion</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_Aprobado_Devolver_a_borrador</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cerrado" name="Cerrado">
      <bpmn:incoming>Flow_En_ejecucion_Cerrar_programa_hacia_Cerrado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_inicio" sourceRef="StartEvent_1" targetRef="Task_Borrador__Aprobar_programa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Borrador_Aprobar_programa_hacia_Aprobado" sourceRef="Task_Borrador__Aprobar_programa" targetRef="Gateway_Aprobado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Aprobado_Iniciar_ejecucion" sourceRef="Gateway_Aprobado" targetRef="Task_Aprobado__Iniciar_ejecucion">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aprobado_Iniciar_ejecucion_hacia_En_ejecucion" sourceRef="Task_Aprobado__Iniciar_ejecucion" targetRef="Task_En_ejecucion__Cerrar_programa">
      <bpmn:extensionElements>
        <sgc:transicion rol="Auditor Interno" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_Aprobado_Devolver_a_borrador" sourceRef="Gateway_Aprobado" targetRef="Task_Aprobado__Devolver_a_borrador">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aprobado_Devolver_a_borrador_hacia_Borrador" sourceRef="Task_Aprobado__Devolver_a_borrador" targetRef="Task_Borrador__Aprobar_programa">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="1" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_En_ejecucion_Cerrar_programa_hacia_Cerrado" sourceRef="Task_En_ejecucion__Cerrar_programa" targetRef="End_Cerrado">
      <bpmn:extensionElements>
        <sgc:transicion rol="DPGC" autoaprobacion="0" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Programa_Auditoria" bpmnElement="Participant_Programa_Auditoria" isHorizontal="true">
        <dc:Bounds x="200" y="80" width="1146" height="320" />
