      <bpmndi:BPMNEdge id="Edge_Flow_Borrador_Aprobar_programa_hacia_Aprobado" bpmnElement="Flow_Borrador_Aprobar_programa_hacia_Aprobado">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="490" y="320" />
        <di:waypoint x="630" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Aprobado_Iniciar_ejecucion" bpmnElement="Flow_gw_Aprobado_Iniciar_ejecucion">
        <di:waypoint x="680" y="320" />
        <di:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Aprobado_Iniciar_ejecucion_hacia_En_ejecucion" bpmnElement="Flow_Aprobado_Iniciar_ejecucion_hacia_En_ejecucion">
        <di:waypoint x="890" y="280" />
        <di:waypoint x="890" y="160" />
        <di:waypoint x="1030" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_gw_Aprobado_Devolver_a_borrador" bpmnElement="Flow_gw_Aprobado_Devolver_a_borrador">
        <di:waypoint x="655" y="295" />
        <di:waypoint x="655" y="160" />
        <di:waypoint x="830" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Aprobado_Devolver_a_borrador_hacia_Borrador" bpmnElement="Flow_Aprobado_Devolver_a_borrador_hacia_Borrador">
        <di:waypoint x="830" y="160" />
        <di:waypoint x="550" y="160" />
