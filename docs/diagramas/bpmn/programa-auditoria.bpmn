      <bpmndi:BPMNShape id="Shape_Lane_Auditor_Interno" bpmnElement="Lane_Auditor_Interno" isHorizontal="true">
        <dc:Bounds x="230" y="240" width="1116" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Borrador__Aprobar_programa" bpmnElement="Task_Borrador__Aprobar_programa">
        <dc:Bounds x="430" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Aprobado__Iniciar_ejecucion" bpmnElement="Task_Aprobado__Iniciar_ejecucion">
        <dc:Bounds x="830" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Aprobado__Devolver_a_borrador" bpmnElement="Task_Aprobado__Devolver_a_borrador">
        <dc:Bounds x="830" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_En_ejecucion__Cerrar_programa" bpmnElement="Task_En_ejecucion__Cerrar_programa">
        <dc:Bounds x="1030" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Aprobado" bpmnElement="Gateway_Aprobado">
        <dc:Bounds x="630" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cerrado" bpmnElement="End_Cerrado">
        <dc:Bounds x="1230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="230" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_inicio" bpmnElement="Flow_inicio">
        <di:waypoint x="266" y="160" />
        <di:waypoint x="430" y="160" />
